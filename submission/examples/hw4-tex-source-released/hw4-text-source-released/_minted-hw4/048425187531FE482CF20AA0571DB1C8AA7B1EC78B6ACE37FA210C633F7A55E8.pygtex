\begin{Verbatim}[commandchars=\\\{\}]
\PYG{c+c1}{// Distributes items round\PYGZhy{}robin across 3 lanes, tagging with sequence number}
\PYG{n}{seq}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{l+m+mi}{0}\PYG{p}{;}
\PYG{k}{while}\PYG{+w}{ }\PYG{p}{(}\PYG{k+kc}{true}\PYG{p}{)}\PYG{+w}{ }\PYG{p}{\PYGZob{}}
\PYG{+w}{    }\PYG{n}{A}\PYG{+w}{ }\PYG{n}{a}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{read}\PYG{p}{(}\PYG{n}{input}\PYG{p}{);}
\PYG{+w}{    }\PYG{n}{lane}\PYG{+w}{ }\PYG{o}{=}\PYG{+w}{ }\PYG{n}{seq}\PYG{+w}{ }\PYG{o}{\PYGZpc{}}\PYG{+w}{ }\PYG{l+m+mi}{3}\PYG{p}{;}
\PYG{+w}{    }\PYG{n}{emit}\PYG{p}{(}\PYG{n}{out}\PYG{o}{[}\PYG{n}{lane}\PYG{o}{]}\PYG{p}{,}\PYG{+w}{ }\PYG{p}{(}\PYG{n}{a}\PYG{p}{,}\PYG{+w}{ }\PYG{n}{seq}\PYG{p}{));}\PYG{+w}{   }\PYG{c+c1}{// send tagged item to lane}
\PYG{+w}{    }\PYG{n}{seq}\PYG{o}{++}\PYG{p}{;}
\PYG{p}{\PYGZcb{}}
\end{Verbatim}
